{
  "name": "adam",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "dev": "eve dev",
    "start": "eve start",
    "typecheck": "tsc",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "lint:ci": "biome ci .",
    "format": "biome check --write . && prettier --write \"**/*.{md,yml,yaml,css}\"",
    "format:check": "biome check . && prettier --check \"**/*.{md,yml,yaml,css}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.40",
    "@braintrust/otel": "^0.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/winston-transport": "^0.31.0",
    "@posthog/ai": "^8.7.1",
    "@upstash/agentkit-eve": "^0.3.0",
    "@upstash/agentkit-eve-extension": "^0.4.0",
    "@upstash/redis": "^1.38.2",
    "@vercel/otel": "^2.1.3",
    "ai": "^7.0.38",
    "eve": "^0.31.3",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "24.x",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "knip": "^6.32.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.21.0"
}
