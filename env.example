# Copy to .env.local and fill in. (Named env.example without the leading dot
# so it is never matched by .env* ignore/deny rules.)

# Agent model, through the Vercel AI Gateway. Local development needs one
# gateway credential, and startup does not validate it because a Vercel
# deployment uses the project's OIDC token and sets nothing. Either set an AI
# Gateway API key here, or link a Vercel project with `pnpm exec eve link`,
# which replaces .env.local with that project's Development variables plus a
# 12-hour VERCEL_OIDC_TOKEN. See "Model access" in docs/configuration.md.
# AI_GATEWAY_API_KEY=

# Optional AI Gateway model ID. The required form is provider/model, for
# example openai/gpt-5 or anthropic/claude-sonnet-5, not a bare gpt-5: eve
# build fails on a bare ID without naming this variable. Read when the agent
# is built, not when it starts.
# AI_GATEWAY_MODEL=openai/gpt-5

# Upstash Redis (memory, RAG, chat history, rate limiting, tool caching)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Braintrust (AI trace destination)
BRAINTRUST_API_KEY=

# PostHog (log destination; host is region-specific)
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_TOKEN=

# Logging. One of: error, warn, info, http, verbose, debug, silly. Anything
# else is rejected at startup — winston silently drops every record for a
# level it cannot resolve.
LOG_LEVEL=info

# service.name on exported logs and metrics; keep it equal to the eve agent
# name. eve's trace pipeline reads the same variable.
OTEL_SERVICE_NAME=adam

# OTLP collector. Neither PostHog nor Braintrust ingests OTLP metrics, so the
# metric pipeline stays off until this is set (the instruments are no-ops
# meanwhile). Note it also becomes the destination for every span, including
# non-AI ones, through agent/instrumentation/otlp.ts.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Opens the agent to anyone, with no sign-in. Unset or false keeps a deployed
# agent closed: in production, callers the auth list does not recognize get a
# 401. true accepts them as anonymous callers, for a public demo, and turns
# eve's default tools off for every caller: no sandbox shell or files, no web
# fetch, no web search, no sub-agent. Chat, memory, chat history and document
# search (search, search_aggregate, search_count) stay. The search index is
# shared, so anyone can read every document in it: index only public
# material. Anonymous memory and chat history expire 24 hours after the
# session's last turn. The tools are decided at build time, so set it for the
# build too. Only true and false are accepted; anything else fails startup.
# Do not turn it on without a spend limit in front of the model. See
# "Anonymous access" in docs/configuration.md.
# ALLOW_ANONYMOUS_ACCESS=false
